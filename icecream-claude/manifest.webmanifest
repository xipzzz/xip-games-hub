{
  "name": "Ice Cream Sort",
  "short_name": "Ice Cream",
  "description": "A calm ice-cream colour-sort puzzle for kids. No ads, no timers.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
